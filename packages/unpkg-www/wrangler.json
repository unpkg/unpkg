{
  "compatibility_date": "2024-12-05",
  "main": "./src/worker.ts",
  "assets": { "directory": "./public" },
  "build": { "command": "pnpm run build:assets" },

  "name": "unpkg-www",
  "observability": { "enabled": true, "head_sampling_rate": 0.001 },
  "kv_namespaces": [
    { "binding": "SHIELD_RULES", "id": "3a1a277aa6f34659be126b05eab2f0a5" },
    { "binding": "CACHE_GENERATIONS", "id": "3691adadda9b45e1b90a245f3d799d68" }
  ],
  "routes": [
    { "pattern": "www.unpkg.com", "custom_domain": true },
    { "pattern": "unpkg.com", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.unpkg.com",
    "ASSETS_ORIGIN": "https://unpkg.com",
    "DEV": false,
    "ESM_ORIGIN": "https://esm.unpkg.com",
    "FILES_ORIGIN": "https://fly.unpkg.com",
    "MODE": "production",
    "ORIGIN": "https://unpkg.com",
    "GA_MEASUREMENT_ID": "G-LS43PRL4YE"
  },

  "env": {
    "dev": {
      "name": "unpkg-www-dev",
      "routes": [],
      "vars": {
        "APP_ORIGIN": "http://localhost:3001",
        "ASSETS_ORIGIN": "http://localhost:8000",
        "DEV": true,
        "ESM_ORIGIN": "http://localhost:3002",
        "FILES_ORIGIN": "http://localhost:4000",
        "MODE": "development",
        "ORIGIN": "http://localhost:3000"
      }
    },

    "staging": {
      "name": "unpkg-www-staging",
      "observability": { "enabled": true },
      "kv_namespaces": [
        { "binding": "SHIELD_RULES", "id": "52069581860c484da319cd507d17eaf3" },
        { "binding": "CACHE_GENERATIONS", "id": "498d5bb57a2e491a920bc58563ee7a42" }
      ],
      "routes": [
        { "pattern": "www.unpkg.dev", "custom_domain": true },
        { "pattern": "unpkg.dev", "custom_domain": true }
      ],
      "vars": {
        "APP_ORIGIN": "https://app.unpkg.dev",
        "ASSETS_ORIGIN": "https://unpkg.dev",
        "DEV": false,
        "ESM_ORIGIN": "https://esm.unpkg.dev",
        "FILES_ORIGIN": "https://fly.unpkg.dev",
        "MODE": "staging",
        "ORIGIN": "https://unpkg.dev"
      }
    }
  }
}
