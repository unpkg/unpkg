{
  "name": "unpkg-files",
  "description": "The file server for UNPKG",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./dist/unpkg-files.d.ts",
    "default": "./dist/unpkg-files.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@esm.sh/cjs-module-lexer": "1.1.0",
    "chalk": "^5.4.1",
    "es-module-lexer": "^1.6.0",
    "esbuild": "^0.24.2",
    "gunzip-maybe": "^1.4.2",
    "mrmime": "^2.0.1",
    "semver": "^7.6.3",
    "tar-stream": "^3.1.7",
    "unpkg-worker": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.8",
    "@types/gunzip-maybe": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "@types/tar-stream": "^3.1.3",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "dev": "MODE=development bun --port 4000 ./src/server.ts",
    "test": "bun --preload=./test/setup.ts test",
    "deploy": "fly deploy ../.. -c ./packages/unpkg-files/fly.json",
    "deploy:staging": "fly deploy ../.. -c ./packages/unpkg-files/fly.staging.json"
  }
}
