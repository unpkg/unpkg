{
  "app": "unpkg",
  "primary_region": "sjc",
  "build": {
    "dockerfile": "./Dockerfile",
    "args": {
      "MODE": "production"
    }
  },
  "http_service": {
    "internal_port": 3000,
    "auto_start_machines": true,
    "auto_stop_machines": "suspend",
    "min_machines_running": 2,
    "processes": [
      "app"
    ],
    "concurrency": {
      "type": "requests",
      "soft_limit": 10,
      "hard_limit": 100
    },
    "checks": [
      {
        "grace_period": "5s",
        "interval": "1m0s",
        "method": "get",
        "path": "/_health",
        "timeout": "5s",
        "restart_limit": 3
      }
    ]
  },
  "vm": {
    "size": "performance-2x"
  },
  "env": {
    "UNPKG_TARBALL_CACHE_DIR": "/data/tarball-cache",
    "UNPKG_TARBALL_CACHE_MAX_BYTES": "14000000000",
    "UNPKG_TARBALL_CACHE_ADMISSION": "2",
    "UNPKG_STREAM_FIRST_SIGHTINGS": "2",
    "UNPKG_EXTRACTED_CACHE": "off",
    "UNPKG_FILE_CACHE_DIR": "/data/unpkg-file-cache",
    "UNPKG_FILE_CACHE_MAX_BYTES": "6000000000",
    "UNPKG_FILE_CACHE_PROMOTION": "10",
    "UNPKG_FILE_CACHE_MIN_TARBALL_BYTES": "262144",
    "UNPKG_MAX_CONCURRENT_TARBALLS": "32",
    "UNPKG_TARBALL_QUEUE_TIMEOUT_MS": "20000",
    "UNPKG_RSS_WATCHDOG_BYTES": "3221225472"
  },
  "mounts": [
    {
      "source": "unpkg_cache",
      "destination": "/data"
    }
  ],
  "processes": {
    "app": "bun --smol run ./dist/server.js"
  }
}
